# ---------------------------------------------------------------------------
# backend/.env.example
# Copy this to backend/.env and fill in real values for anything marked TODO.
# For local development the defaults below work as-is with docker-compose.yml.
# NEVER commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# ─── Server ───
PORT=5001
NODE_ENV=development

# ─── Database (local Postgres via Docker/Colima) ───
# Credentials must match docker-compose.yml.
DATABASE_URL="postgresql://krishna:krishna_dev_pw@localhost:5432/krishna_bakers?schema=public"

# ─── Redis (local cache via Docker/Colima) ───
REDIS_URL="redis://localhost:6379"

# ─── Auth (JWT) ───
# Generate strong secrets for anything non-local:  openssl rand -base64 48
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# ─── Email / OTP ───
# console -> OTPs are printed to the backend console (no credentials needed; ideal for local dev)
# smtp    -> real email is sent using the SMTP_* settings below
MAIL_DRIVER="console"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Shree Krishna Bakers <noreply@shreekrishna.com>"

# ─── CORS ───
# Comma-separated allowed origins for production. In development, all localhost ports are allowed.
FRONTEND_URL="http://localhost:5173"
